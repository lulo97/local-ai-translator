{
  "manifest_version": 3,
  "name": "Local AI Tools",
  "version": "1.0.0",
  "description": "Select text → Translate / SentencesTrans / WordTrans / MCQ using your local llama.cpp.",
  "permissions": ["contextMenus"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "src/background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/jquery.min.js",
        "lib/marked.min.js",
        "lib/purify.min.js",
        "src/config.js",
        "src/common_words.js",
        "src/styles.js",
        "src/core.js",
        "src/features.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
